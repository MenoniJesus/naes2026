# Arquivos que NÃO são enviados no `gcloud app deploy`.
# O .env É enviado de propósito: é de onde a aplicação lê SECRET_KEY, DATABASE_URL e ANTHROPIC_API_KEY.
.gcloudignore
.git
.gitignore

# Ambiente local, IDE e caches
.venv/
.idea/
.pytest_cache/
__pycache__/
*.pyc
*.sqlite3

# Ferramentas de desenvolvimento e agentes de IA
.agents/
.claude/
uv.lock
comando.txt

# Ignored by the build system
/setup.cfg
